{
  "manifest_version": 3,
  "name": "PROS - LinkedIn Focus Guard",
  "version": "0.2.0",
  "description": "Prevents doom scrolling on LinkedIn. Tracks time, alerts you, suggests smart actions.",
  "permissions": ["activeTab", "storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*", "http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
