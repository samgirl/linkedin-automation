# AI Content Radar Configuration
# Copy this file to .env and fill in your settings

# AI Provider: openai | openrouter | ollama | gemini
AI_PROVIDER=gemini

# --- Gemini (FREE - get key at https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- OpenRouter ---
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o

# --- Ollama (local, free) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Database
DATABASE_URL=sqlite:///data/content_radar.db

# Search Settings
MAX_RESULTS_PER_SEARCH=200
MIN_RANKING_SCORE=40

# AI Generation Settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500
MAX_COMMENT_WORDS=120

# Cache
CACHE_TTL_HOURS=24

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/content_radar.log

# UI
STREAMLIT_THEME=dark
