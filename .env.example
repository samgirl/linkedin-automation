# PROS Production Environment Variables (FREE Stack)
# Copy these values into Render's Environment Variables

# --- App ---
APP_NAME=PROS
APP_ENV=production
SECRET_KEY=<generate-64-char-random-string>
FRONTEND_URL=https://your-app.vercel.app

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Redis (Upstash) ---
REDIS_URL=redis://default:password@xxx.upstash.io:6379

# --- Auth ---
JWT_SECRET_KEY=<generate-64-char-random-string>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=https://pros-backend.onrender.com/api/auth/callback/linkedin

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://pros-backend.onrender.com/api/auth/callback/google

# --- AI (at least one required) ---
DEFAULT_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Encryption ---
ENCRYPTION_KEY=<generate-44-char-random-string>
