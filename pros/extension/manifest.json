{
  "manifest_version": 3,
  "name": "PROS Capture",
  "version": "1.0.0",
  "description": "Capture your professional life - one click, everything remembered",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "context_menus": [
    {
      "id": "save-to-pros",
      "title": "Save to PROS",
      "contexts": ["selection", "page", "link"]
    },
    {
      "id": "quick-note",
      "title": "Quick Note",
      "contexts": ["selection"]
    }
  ],
  "commands": {
    "save-page": {
      "suggested": {
        "key": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    },
    "quick-note": {
      "suggested": {
        "key": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
